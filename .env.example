# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration (Supported: gemini/gemini-1.5-flash, gemini/gemini-2.0-flash, gemini/gemini-1.5-pro)
GEMINI_MODEL=gemini/gemini-1.5-flash

# Backend Configuration
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./agentflow.db

# Optional Search API Keys (if using Tavily or Serper)
# SERPER_API_KEY=your_serper_api_key_here
# TAVILY_API_KEY=your_tavily_api_key_here
